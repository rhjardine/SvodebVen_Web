# Copia este archivo a .env (nunca lo subas al repositorio).
NODE_ENV=production
PORT=3000
# Número de proxies delante del servidor (Render/Railway/Nginx = 1).
TRUST_PROXY_HOPS=1
# Orígenes permitidos para enviar la planilla (separados por coma).
ALLOWED_ORIGINS=https://svodeb.org
# URL canónica: habilita sitemap.xml y la línea Sitemap en robots.txt.
PUBLIC_SITE_URL=https://svodeb.org

# Recepción de afiliaciones por correo. Todas o ninguna:
# sin ellas, la API responde 503 y el sitio ofrece el envío por correo como alternativa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SVODEB <no-responder@svodeb.org>"
SECRETARIA_EMAIL=secretaria@svodeb.org
