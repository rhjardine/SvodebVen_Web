{
  "name": "svodeb-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:api": "PORT=3001 tsx watch server/index.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir ../dist/ssr && tsx scripts/prerender.ts && esbuild server/index.ts --platform=node --target=node20 --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke.ts",
    "smtp:check": "node --env-file-if-exists=.env --import tsx scripts/smtp-check.ts",
    "content:audit": "tsx scripts/content-audit.ts",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "db:local": "bash scripts/db-local.sh",
    "db:provision": "bash scripts/db-provision.sh",
    "lint": "eslint .",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.7.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^10",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
